<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nex.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/nex-v3/bin/nex-server</string>
    <string>-addr</string>
    <string>:8080</string>
    <string>-data-dir</string>
    <string>/opt/nex-v3/data</string>
    <string>-runners-dir</string>
    <string>/opt/nex-v3/runners</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/opt/nex-v3/logs/nex-server.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/nex-v3/logs/nex-server.err.log</string>
</dict>
</plist>
