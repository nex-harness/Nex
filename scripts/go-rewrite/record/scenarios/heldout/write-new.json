{
  "id": "H-write-new",
  "title": "write-new",
  "model": {
    "steps": [
      {
        "toolCalls": [
          {
            "id": "c1",
            "name": "Write",
            "args": {
              "file_path": "$WS/sub/new.txt",
              "content": "h\u00e9llo\nw\u00f6rld\n"
            }
          }
        ]
      },
      {
        "text": "Created."
      }
    ]
  },
  "files": {},
  "script": [
    {
      "op": "waitReady"
    },
    {
      "op": "command",
      "type": "createSession",
      "as": "created",
      "payload": {
        "workspaceId": "$WS",
        "firstInput": {
          "text": "do it",
          "modelSelection": {
            "providerId": "mock",
            "modelId": "mock-model",
            "options": {
              "reasoningLevel": "none"
            }
          }
        }
      }
    },
    {
      "op": "subscribe",
      "sessionFrom": "created",
      "as": "sub"
    },
    {
      "op": "waitTelemetry",
      "kind": "turn.terminal"
    }
  ],
  "host": {
    "permission": "allow_once"
  }
}
