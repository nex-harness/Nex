{
  "id": "H-edit-ambiguous",
  "title": "edit-ambiguous",
  "model": {
    "steps": [
      {
        "toolCalls": [
          {
            "id": "c1",
            "name": "Read",
            "args": {
              "file_path": "$WS/f.txt"
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "id": "c2",
            "name": "Edit",
            "args": {
              "file_path": "$WS/f.txt",
              "old_string": "foo",
              "new_string": "bar"
            }
          }
        ]
      },
      {
        "text": "ambiguous"
      }
    ]
  },
  "files": {
    "f.txt": "foo foo\n"
  },
  "script": [
    {
      "op": "waitReady"
    },
    {
      "op": "command",
      "type": "createSession",
      "as": "created",
      "payload": {
        "workspaceId": "$WS",
        "firstInput": {
          "text": "do it",
          "modelSelection": {
            "providerId": "mock",
            "modelId": "mock-model",
            "options": {
              "reasoningLevel": "none"
            }
          }
        }
      }
    },
    {
      "op": "subscribe",
      "sessionFrom": "created",
      "as": "sub"
    },
    {
      "op": "waitTelemetry",
      "kind": "turn.terminal"
    }
  ],
  "host": {
    "permission": "allow_once"
  }
}
