{
  "name": "@nex/next-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Agent runner for the next server: connects to ws://.../runner and serves pi-backed sessions.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10",
    "@nex/services": "workspace:*",
    "@nex/shared": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "^8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nex/provider": "workspace:*",
    "@nex/rpc": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
