{
  "name": "Nex",
  "slug": "nex",
  "identifier": "com.nex.app",
  "version": "0.4.1",
  "copyright": "© 2026 Nex",
  "main": "./cmd/nex-app",
  "icon": "clients/app/resources/icon.png",
  "out": "dist/clients",
  "bindings": "clients/web/src/host/mygo.gen.ts",
  "devUrl": "http://localhost:5173",
  "devCommand": "npm --prefix clients/web run dev -- --host",
  "buildCommand": "npm --prefix clients/web run build",
  "urlSchemes": ["nex"],
  "macos": {
    "minimumSystemVersion": "12.0",
    "dmgTitle": "Nex",
    "infoPlist": {
      "NSCameraUsageDescription": "Scan QR codes to pair with your Nex servers."
    }
  },
  "windows": {
    "displayName": "Nex",
    "installDirName": "Nex"
  },
  "linux": {
    "comment": "Nex AI Coding Agent Workbench",
    "categories": ["Development", "Utility"],
    "webview": true,
    "command": "nex",
    "formats": ["deb", "rpm", "pkgbuild"]
  },
  "ios": {
    "minimumSystemVersion": "17.0",
    "orientations": ["portrait", "landscape"],
    "launchScreen": {
      "background": "#121214",
      "image": "clients/app/resources/launch-logo.png"
    },
    "infoPlist": {
      "NSCameraUsageDescription": "Scan QR codes to pair with your Nex servers.",
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSAllowsLocalNetworking": true
      }
    }
  },
  "android": {
    "minSdk": 26,
    "permissions": ["CAMERA"],
    "adaptiveIcon": {
      "foreground": "clients/app/resources/icon-foreground.png",
      "background": "#121214"
    },
    "splash": "#121214"
  }
}
