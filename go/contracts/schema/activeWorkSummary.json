{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "foregroundExecutionId": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "primaryTurn",
        "foregroundSubagent",
        "compact",
        "goalVerifier",
        "goalContinuation",
        "turnSteer"
      ],
      "type": "string"
    },
    "startedAt": {
      "type": "number"
    }
  },
  "required": [
    "kind",
    "startedAt"
  ],
  "type": "object"
}
