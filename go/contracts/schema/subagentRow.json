{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "properties": {
        "canEdit": {
          "const": true,
          "type": "boolean"
        },
        "canFork": {
          "const": true,
          "type": "boolean"
        },
        "canRetry": {
          "const": true,
          "type": "boolean"
        },
        "canRewindFiles": {
          "const": true,
          "type": "boolean"
        },
        "editDisposition": {
          "enum": [
            "rewind",
            "fork"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "backgrounded": {
      "const": true,
      "type": "boolean"
    },
    "childSessionId": {
      "type": "string"
    },
    "createdAt": {
      "type": "number"
    },
    "createdAtSeq": {
      "type": "number"
    },
    "endedAt": {
      "type": "number"
    },
    "entityId": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "subagent",
      "type": "string"
    },
    "parentToolCallId": {
      "type": "string"
    },
    "productTurnId": {
      "minLength": 1,
      "type": "string"
    },
    "rowId": {
      "type": "number"
    },
    "startedAt": {
      "type": "number"
    },
    "status": {
      "enum": [
        "running",
        "success",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "subagentType": {
      "type": "string"
    },
    "summaryText": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "visibility": {
      "const": "visible",
      "type": "string"
    },
    "workId": {
      "type": "string"
    }
  },
  "required": [
    "rowId",
    "turnId",
    "createdAt",
    "createdAtSeq",
    "kind",
    "subagentType",
    "status",
    "summaryText"
  ],
  "type": "object"
}
