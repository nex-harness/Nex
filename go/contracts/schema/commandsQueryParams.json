{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clock": {
      "const": true,
      "type": "boolean"
    },
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "minLength": 1,
            "type": "string"
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sessionId",
          "commandId"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "commands"
  ],
  "type": "object"
}
