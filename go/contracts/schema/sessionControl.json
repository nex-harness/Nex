{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "activeWorks": {
      "items": {
        "properties": {
          "foregroundExecutionId": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "primaryTurn",
              "foregroundSubagent",
              "compact",
              "goalVerifier",
              "goalContinuation",
              "turnSteer"
            ],
            "type": "string"
          },
          "startedAt": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "startedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "apiRetry": {
      "anyOf": [
        {
          "properties": {
            "attempt": {
              "type": "number"
            },
            "maxAttempts": {
              "type": "number"
            },
            "nextRetryAt": {
              "type": "number"
            },
            "reasonCode": {
              "type": "string"
            }
          },
          "required": [
            "attempt",
            "maxAttempts",
            "nextRetryAt",
            "reasonCode"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "canStop": {
      "type": "boolean"
    },
    "lastError": {
      "anyOf": [
        {
          "properties": {
            "at": {
              "type": "number"
            },
            "attribution": {
              "additionalProperties": false,
              "properties": {
                "errorPhase": {
                  "enum": [
                    "prepare",
                    "configuration",
                    "connect",
                    "response",
                    "stream",
                    "parse",
                    "validation",
                    "unhandled"
                  ],
                  "type": "string"
                },
                "exceptionKind": {
                  "enum": [
                    "api_call",
                    "generic",
                    "protocol",
                    "provider_business",
                    "transport",
                    "type_error",
                    "validation"
                  ],
                  "type": "string"
                },
                "modelId": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "providerErrorCode": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "providerId": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "providerKind": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "source": {
                  "enum": [
                    "provider",
                    "runtime",
                    "tool",
                    "network"
                  ],
                  "type": "string"
                },
                "statusCode": {
                  "maximum": 599,
                  "minimum": 100,
                  "type": "integer"
                },
                "transport": {
                  "enum": [
                    "http",
                    "sse",
                    "websocket"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "code": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "recoverable": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "provider",
                "runtime",
                "tool",
                "network"
              ],
              "type": "string"
            },
            "traceId": {
              "type": "string"
            },
            "underlyingErrorDetail": {
              "type": "string"
            },
            "underlyingErrorMessage": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "recoverable",
            "at",
            "source"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "enum": [
        "draft",
        "prewarming",
        "running",
        "completedSuccess",
        "completedInterrupted",
        "error"
      ],
      "type": "string"
    },
    "sessionEnded": {
      "type": "boolean"
    },
    "stopState": {
      "enum": [
        "idle",
        "stoppable",
        "stopping"
      ],
      "type": "string"
    },
    "stopTargetKind": {
      "enum": [
        "assistant",
        "tool",
        "subagent",
        "compact",
        "goalVerifier",
        "goalContinuation",
        "turnSteer",
        "mixed",
        "unknown"
      ],
      "type": "string"
    }
  },
  "required": [
    "phase",
    "sessionEnded",
    "canStop",
    "stopState",
    "stopTargetKind",
    "activeWorks",
    "lastError",
    "apiRetry"
  ],
  "type": "object"
}
