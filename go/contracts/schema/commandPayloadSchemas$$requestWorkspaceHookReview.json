{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundleDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "remoteSessionId": {
      "minLength": 1,
      "type": "string"
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    },
    "workspaceIdentity": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "workspaceIdentity",
    "bundleDigest"
  ],
  "type": "object"
}
