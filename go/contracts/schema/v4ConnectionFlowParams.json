{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connectionId": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "saturated",
        "drained",
        "closed"
      ],
      "type": "string"
    }
  },
  "required": [
    "connectionId",
    "state"
  ],
  "type": "object"
}
