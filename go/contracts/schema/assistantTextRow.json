{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "properties": {
        "canEdit": {
          "const": true,
          "type": "boolean"
        },
        "canFork": {
          "const": true,
          "type": "boolean"
        },
        "canRetry": {
          "const": true,
          "type": "boolean"
        },
        "canRewindFiles": {
          "const": true,
          "type": "boolean"
        },
        "editDisposition": {
          "enum": [
            "rewind",
            "fork"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "assistantResponseId": {
      "minLength": 1,
      "type": "string"
    },
    "createdAt": {
      "type": "number"
    },
    "createdAtSeq": {
      "type": "number"
    },
    "entityId": {
      "minLength": 1,
      "type": "string"
    },
    "feedback": {
      "enum": [
        "like",
        "dislike"
      ],
      "type": "string"
    },
    "kind": {
      "const": "assistantText",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "productTurnId": {
      "minLength": 1,
      "type": "string"
    },
    "rowId": {
      "type": "number"
    },
    "state": {
      "enum": [
        "streaming",
        "complete",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "visibility": {
      "const": "visible",
      "type": "string"
    }
  },
  "required": [
    "rowId",
    "turnId",
    "createdAt",
    "createdAtSeq",
    "kind",
    "text",
    "state"
  ],
  "type": "object"
}
