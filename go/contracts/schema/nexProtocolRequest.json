{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ]
    },
    "method": {
      "minLength": 1,
      "type": "string"
    },
    "params": {},
    "trace": {
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "minLength": 1,
          "type": "string"
        },
        "spanId": {
          "minLength": 1,
          "type": "string"
        },
        "traceId": {
          "minLength": 1,
          "type": "string"
        },
        "traceparent": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "method"
  ],
  "type": "object"
}
