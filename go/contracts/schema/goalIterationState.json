{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "properties": {
          "content": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "inProgress",
              "completed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "iteration": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "required": [
    "iteration",
    "items",
    "updatedAt"
  ],
  "type": "object"
}
