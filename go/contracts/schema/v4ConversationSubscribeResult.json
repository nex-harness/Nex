{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ack": {
      "properties": {
        "logEpoch": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "snapshot",
            "resume"
          ],
          "type": "string"
        },
        "openTiming": {
          "additionalProperties": false,
          "properties": {
            "cliBootstrapMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "cliProcessState": {
              "enum": [
                "spawned",
                "reused"
              ],
              "type": "string"
            },
            "cliRequestMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "cliSessionRestoreMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "hostPrepareMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "initialFrameEncodeMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "providerRegistrySyncMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "sessionRuntimeState": {
              "enum": [
                "cold",
                "warm"
              ],
              "type": "string"
            },
            "snapshotRowCount": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "taskMetaReadMs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "const": 1,
              "type": "number"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        },
        "subscriptionId": {
          "type": "string"
        }
      },
      "required": [
        "subscriptionId",
        "mode",
        "logEpoch"
      ],
      "type": "object"
    }
  },
  "required": [
    "ack"
  ],
  "type": "object"
}
