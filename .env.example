# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
NEX_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
NEX_CDN_BASE_URL=https://cdn-zcode.z.ai

# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
NEX_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/nex/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
NEX_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
NEX_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
NEX_DIST_BASE_URL=
